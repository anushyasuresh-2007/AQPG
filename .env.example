# ==============================================================================
# AQPG Environment Variables Configuration Example
# Copy this file to '.env' in backend/ and frontend/ or root as required.
# DO NOT include sensitive passwords, secret keys, or real API keys in Git.
# ==============================================================================

# ------------------------------------------------------------------------------
# Backend Configuration (backend/.env)
# ------------------------------------------------------------------------------
# Database URL (Default SQLite fallback or MySQL setup)
# MySQL Example: mysql+mysqlconnector://user:password@localhost:3306/aqpg_db
# SQLite Example: sqlite:///./aqpg_audit.db
DATABASE_URL=mysql+mysqlconnector://root:@localhost:3306/aqpg_db

# Security & Authentication
SECRET_KEY=replace-with-a-strong-random-secret-key-min-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Optional Third-Party Services
GEMINI_API_KEY=your_gemini_api_key_here

# ------------------------------------------------------------------------------
# Frontend Configuration (frontend/.env)
# ------------------------------------------------------------------------------
# API Base URL for backend communication
VITE_API_BASE_URL=http://127.0.0.1:8011/api/v1
