# ==============================================================================
# AQPG Environment Variables Configuration Example
# Copy this file to '.env' in backend/ and frontend/ or root as required.
# DO NOT include sensitive passwords, secret keys, or real API keys in Git.
# ==============================================================================

# ------------------------------------------------------------------------------
# Backend Configuration (backend/.env)
# ------------------------------------------------------------------------------
# AI Model Provider Selection (v17_2 is production default)
AI_PROVIDER=v17_2
V17_2_MODEL_PATH=backend/ml/models/checkpoints/flan_t5_v17_2/best_model

# Environment & CORS
ENVIRONMENT=production
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://localhost:5174","https://YOUR-VERCEL-DOMAIN.vercel.app"]

# Database URL
# MySQL Example: mysql+mysqlconnector://user:password@localhost:3306/aqpg_db
# SQLite Fallback Example: sqlite:///./aqpg_audit.db
DATABASE_URL=sqlite:///./aqpg_audit.db

# Security & Authentication
SECRET_KEY=replace-with-a-strong-random-secret-key-min-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Optional Third-Party API Keys
GEMINI_API_KEY=your_gemini_api_key_here

# ------------------------------------------------------------------------------
# Frontend Configuration (frontend/.env)
# ------------------------------------------------------------------------------
# Production API URL for backend communication
VITE_API_URL=https://YOUR-BACKEND-DOMAIN.com/api/v1
